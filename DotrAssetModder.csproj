<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>latestmajor</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- The extractor runs too rarely to tier up; compile its loops optimised from the start. -->
        <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="DiscUtils.Iso9660" Version="0.16.13" />
      <PackageReference Include="NativeFileDialogSharp" Version="0.5.0" />
      <PackageReference Include="NAudio" Version="2.3.0" />
      <PackageReference Include="Raylib-cs" Version="8.0.0" />
      <PackageReference Include="Sdcb.FFmpeg" Version="7.0.0" />
      <PackageReference Include="Sdcb.FFmpeg.runtime.windows-x64" Version="7.1.0" />
      <PackageReference Include="rlImgui-cs" Version="3.2.0" />
      <PackageReference Include="SharpGLTF.Core" Version="1.0.6" />
      <PackageReference Include="SharpGLTF.Runtime" Version="1.0.6" />
      <PackageReference Include="SharpGLTF.Toolkit" Version="1.0.6" />
      <PackageReference Include="SkiaSharp" Version="2.88.8" />
      <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.8" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="fonts\NotoSansJP-Regular.ttf" />
      <EmbeddedResource Include="fonts\NotoSansJP-Regular.ttf" />
    </ItemGroup>

    <ItemGroup>
      <!-- docs\rollback holds snapshot copies of source files; they are not part of the build. -->
      <Compile Remove="docs\**" />
    </ItemGroup>


</Project>
